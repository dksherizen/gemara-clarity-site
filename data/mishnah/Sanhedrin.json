:"2"},{"i":157,"s":9,"h":"רוֹצֵחַ שֶׁנִּתְעָרֵב בַּאֲחֵרִים כּוּלָּן פְּטוּרִין.","l":"3"},{"i":160,"s":5,"h":"מִי שֶׁנִּתְחַיֵּיב בִּשְׁתֵּי מִיתוֹת בֵּית…","l":"4"},{"i":161,"s":2,"h":"מִי שֶׁלָּקָה וְשָׁנָה, בֵּית דִּין…","l":"5"},{"i":161,"s":18,"h":"הַהוֹרֵג נֶפֶשׁ שֶׁלֹּא בְּעֵדִים, מַכְנִיסִין…","l":"5","c":1},{"i":161,"s":26,"h":"הַגּוֹנֵב אֶת הַקַּסְוָה וְהַמְקַלֵּל בְּקוֹסֵם…","l":"6"}]},{"n":10,"r":[{"i":167,"s":1,"h":"אֵלּוּ הֵן הַנֶּחְנָקִין הַמַּכֶּה אָבִיו…","l":"11:1"},{"i":169,"s":4,"h":"הַמַּכֶּה אָבִיו וְאִמּוֹ אֵינוֹ חַיָּיב…","l":"11:1","c":1},{"i":169,"s":26,"h":"הַגּוֹנֵב נֶפֶשׁ מִיִּשְׂרָאֵל אֵינוֹ חַיָּיב…","l":"11:1","c":1},{"i":171,"s":21,"h":"זָקֵן מַמְרֵא עַל פִּי בֵּית…","l":"11:2"},{"i":175,"s":18,"h":"חוֹמֶר בְּדִבְרֵי סוֹפְרִים מִבְּדִבְרֵי תוֹרָה.","l":"11:3"},{"i":176,"s":4,"h":"אֵין מְמִיתִין אוֹתוֹ לֹא בְּבֵית…","l":"11:4"},{"i":176,"s":12,"h":"נְבִיא הַשֶּׁקֶר הַמִּתְנַבֵּא מַה שֶּׁלֹּא…","l":"11:5–6"}]},{"n":11,"r":[{"i":178,"s":18,"h":"כׇּל יִשְׂרָאֵל יֵשׁ לָהֶם חֵלֶק…","l":"10:1–2"},{"i":213,"s":28,"h":"דּוֹר הַמַּבּוּל אֵין לָהֶם חֵלֶק…","l":"10:3"},{"i":219,"s":10,"h":"עֲשֶׂרֶת הַשְּׁבָטִים אֵינָן עֲתִידִין לַחֲזוֹר…","l":"10:3","c":1},{"i":221,"s":15,"h":"אַנְשֵׁי עִיר הַנִּדַּחַת אֵין לָהֶם…","l":"10:4–6"}]}]}
