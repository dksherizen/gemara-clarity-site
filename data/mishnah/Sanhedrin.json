{"m":"Sanhedrin","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"דִּינֵי מָמוֹנוֹת בִּשְׁלֹשָׁה, גְּזֵילוֹת וַחֲבָלוֹת…","l":"1–6"}]},{"n":2,"r":[{"i":34,"s":7,"h":"כֹּהֵן גָּדוֹל דָּן וְדָנִין אוֹתוֹ…","l":"1–2"},{"i":38,"s":6,"h":"מֵת לוֹ מֵת אֵינוֹ יוֹצֵא…","l":"3"},{"i":39,"s":6,"h":"וּמוֹצִיא לְמִלְחֶמֶת הָרְשׁוּת עַל פִּי…","l":"4"},{"i":40,"s":4,"h":"״לֹא יַרְבֶּה לוֹ נָשִׁים״, אֶלָּא…","l":"4","c":1},{"i":41,"s":8,"h":"״לֹא יַרְבֶּה לּוֹ סוּסִים״, אֶלָּא…","l":"4","c":1},{"i":42,"s":19,"h":"אֵין רוֹכְבִין עַל סוּסוֹ, וְאֵין…","l":"5"}]},{"n":3,"r":[{"i":44,"s":1,"h":"דִּינֵי מָמוֹנוֹת בִּשְׁלֹשָׁה.","l":"1"},{"i":46,"s":23,"h":"אָמַר לוֹ: ״נֶאֱמָן עָלַי אַבָּא…","l":"2"},{"i":47,"s":18,"h":"וְאֵלּוּ הֵן הַפְּסוּלִין: הַמְשַׂחֵק בְּקוּבְיָא…","l":"3"},{"i":53,"s":11,"h":"וְאֵלּוּ הֵן הַקְּרוֹבִין: אָחִיו, וַאֲחִי…","l":"4–5"},{"i":56,"s":16,"h":"כֵּיצַד בּוֹדְקִים אֶת הָעֵדִים?","l":"6–7"},{"i":60,"s":14,"h":"כׇּל זְמַן שֶׁמֵּבִיא רְאָיָה סוֹתֵר…","l":"8"}]},{"n":4,"r":[{"i":62,"s":1,"h":"אֶחָד דִּינֵי מָמוֹנוֹת וְאֶחָד דִּינֵי…","l":"1–2"},{"i":71,"s":22,"h":"סַנְהֶדְרִין הָיְתָה כַּחֲצִי גּוֹרֶן עֲגוּלָּה…","l":"3–4"},{"i":72,"s":19,"h":"כֵּיצַד מְאַיְּימִין אֶת הָעֵדִים עַל…","l":"5"}]},{"n":5,"r":[{"i":78,"s":1,"h":"הָיוּ בּוֹדְקִין אוֹתָן בְּשֶׁבַע חֲקִירוֹת…","l":"1–5"}]},{"n":6,"r":[{"i":83,"s":1,"h":"נִגְמַר הַדִּין מוֹצִיאִין אוֹתוֹ לְסוֹקְלוֹ…","l":"1"},{"i":84,"s":31,"h":"מָצְאוּ לוֹ זְכוּת פְּטָרוּהוּ, וְאִם…","l":"1","c":1},{"i":85,"s":3,"h":"הָיָה רָחוֹק מִבֵּית הַסְּקִילָה כְּעֶשֶׂר…","l":"2"},{"i":87,"s":28,"h":"הָיָה רָחוֹק מִבֵּית הַסְּקִילָה אַרְבַּע…","l":"3"},{"i":88,"s":20,"h":"בֵּית הַסְּקִילָה הָיָה גָּבוֹהַּ שְׁתֵּי קוֹמוֹת.","l":"4"},{"i":89,"s":29,"h":"כׇּל הַנִּסְקָלִין נִתְלִין, דִּבְרֵי רַבִּי אֱלִיעֶזֶר.","l":"4","c":1},{"i":90,"s":21,"h":"כֵּיצַד תּוֹלִין אוֹתוֹ?","l":"4–6","c":1}]},{"n":7,"r":[{"i":97,"s":1,"h":"אַרְבַּע מִיתוֹת נִמְסְרוּ לְבֵית דִּין…","l":"1"},{"i":102,"s":6,"h":"מִצְוַת הַנִּשְׂרָפִין הָיוּ מְשַׁקְּעִין אוֹתוֹ…","