{"m":"Berakhot","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"מֵאֵימָתַי קוֹרִין אֶת שְׁמַע בָּעֲרָבִין?","l":"1"},{"i":17,"s":14,"h":"מֵאֵימָתַי קוֹרִין אֶת שְׁמַע בְּשַׁחֲרִית?","l":"2"},{"i":19,"s":48,"h":"בֵּית שַׁמַּאי אוֹמְרִים: בָּעֶרֶב כָּל…","l":"3"},{"i":20,"s":29,"h":"בַּשַּׁחַר מְבָרֵךְ שְׁתַּיִם לְפָנֶיהָ וְאַחַת לְאַחֲרֶיהָ.","l":"4"},{"i":23,"s":33,"h":"מַזְכִּירִין יְצִיאַת מִצְרַיִם בַּלֵּילוֹת.","l":"5"}]},{"n":2,"r":[{"i":24,"s":18,"h":"הָיָה קוֹרֵא בַּתּוֹרָה וְהִגִּיעַ זְמַן…","l":"1–2"},{"i":28,"s":11,"h":"הַקּוֹרֵא אֶת שְׁמַע וְלֹא הִשְׁמִיעַ…","l":"3"},{"i":30,"s":7,"h":"הָאוּמָּנִין קוֹרִין בְּרֹאשׁ הָאִילָן וּבְרֹאשׁ הַנִּדְבָּךְ.","l":"4–5"},{"i":31,"s":5,"h":"רָחַץ לַיְלָה הָרִאשׁוֹן שֶׁמֵּתָה אִשְׁתּוֹ.","l":"6–8"}]},{"n":3,"r":[{"i":33,"s":17,"h":"מִי שֶׁמֵּתוֹ מוּטָּל לְפָנָיו פָּטוּר…","l":"1–2"},{"i":38,"s":20,"h":"נָשִׁים וַעֲבָדִים וּקְטַנִּים פְּטוּרִין מִקְּרִיאַת…","l":"3"},{"i":39,"s":24,"h":"בַּעַל קֶרִי מְהַרְהֵר בְּלִבּוֹ, וְאֵינוֹ…","l":"4"},{"i":43,"s":20,"h":"הָיָה עוֹמֵד בִּתְפִלָּה וְנִזְכַּר שֶׁהוּא…","l":"5"},{"i":50,"s":15,"h":"זָב שֶׁרָאָה קֶרִי, וְנִדָּה שֶׁפָּלְטָה…","l":"6"}]},{"n":4,"r":[{"i":50,"s":20,"h":"תְּפִלַּת הַשַּׁחַר עַד חֲצוֹת.","l":"1"},{"i":55,"s":10,"h":"רַבִּי נְחוּנְיָא בֶּן הַקָּנָה הָיָה…","l":"2"},{"i":55,"s":23,"h":"רַבָּן גַּמְלִיאֵל אוֹמֵר: בְּכָל יוֹם…","l":"3–6"},{"i":58,"s":38,"h":"רַבִּי אֶלְעָזָר בֶּן עֲזַרְיָה אוֹמֵר…","l":"7"}]},{"n":5,"r":[{"i":59,"s":22,"h":"אֵין עוֹמְדִין לְהִתְפַּלֵּל אֶלָּא מִתּוֹךְ…","l":"1"},{"i":64,"s":15,"h":"מַזְכִּירִין גְּבוּרוֹת גְּשָׁמִים בִּתְחִיַּית הַמֵּתִים…","l":"2"},{"i":65,"s":18,"h":"הָאוֹמֵר: ״עַל קַן צִיפּוֹר יַגִּיעוּ…","l":"3"},{"i":66,"s":3,"h":"הָאוֹמֵר: ״יְבָרְכוּךָ טוֹבִים״ הֲרֵי זֶה…"},{"i":67,"s":16,"h":"הַמִּתְפַּלֵּל וְטָעָה סִימָן רַע לוֹ.","l":"5"}]},{"n":6,"r":[{"i":68,"s":1,"h":"כֵּיצַד מְבָרְכִין עַל הַפֵּירוֹת?","l":"1"},{"i":78,"s":35,"h":"בֵּירַךְ עַל פֵּירוֹת הָאִילָן ״בּוֹרֵא…","l":"2"},{"i":79,"s":20,"h":"וְעַל דָּבָר שֶׁאֵין גִּדּוּלוֹ מִן…","l":"3–4"},{"i":82,"s":21,"h":"בֵּרַךְ עַל הַיַּיִן שֶׁלִּפְנֵי הַמָּזוֹן…","l":"5–6"},{"i":86,"s":1,"h":"הֵבִיאוּ לְפָנָיו מָלִיחַ תְּחִלָּה וּפַת…","l":"7"},{"i":86,"s":16,"h":"אָכַל עֲנָבִים וּתְאֵנִים וְרִמּוֹנִים מְבָרֵךְ…","l":"8"}]},{"n":7,"r":[{"i":88,"s":6,"h":"שְׁלֹשָׁה שֶׁאָכְלוּ כְּאַחַת, חַיָּיבִין לְזַמֵּן.","l":"1–2"},{"i":97,"s":19,"h":"כֵּיצַד מְזַמְּנִין?","l":"3"},{"i":98,"s":37,"h":"שְׁלֹשָׁה שֶׁאָכְלוּ כְּאַחַת אֵינָן רַשָּׁאִין לֵיחָלֵק.","l":"4–5"}]},{"n":8,"r":[{"i":101,"s":19,"h":"אֵלּוּ דְּבָרִים שֶׁבֵּין בֵּית שַׁמַּאי…","l":"1–8"}]},{"n":9,"r":[{"i":106,"s":1,"h":"הָרוֹאֶה מָקוֹם שֶׁנַּעֲשׂוּ בּוֹ נִסִּים…","l":"1–5"}]}]}
