{"m":"Horayot","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"הוֹרוּ בֵּית דִּין לַעֲבוֹר עַל…","l":"1"},{"i":5,"s":20,"h":"הוֹרוּ בֵּית דִּין וְיָדְעוּ שֶׁטָּעוּ…","l":"2–3"},{"i":7,"s":14,"h":"הוֹרוּ בֵּית דִּין, וְיָדַע אֶחָד…","l":"4"},{"i":7,"s":22,"h":"הוֹרוּ בֵּית דִּין שׁוֹגְגִין, וְעָשׂוּ…","l":"4","c":1},{"i":7,"s":28,"h":"הוֹרוּ בֵּית דִּין וְעָשׂוּ כׇּל…","l":"5"}]},{"n":2,"r":[{"i":11,"s":17,"h":"הוֹרָה כֹּהֵן מָשִׁיחַ לְעַצְמוֹ שׁוֹגֵג…","l":"1"},{"i":12,"s":12,"h":"הוֹרָה בִּפְנֵי עַצְמוֹ וְעָשָׂה בִּפְנֵי…","l":"2"},{"i":13,"s":17,"h":"אֵין חַיָּיבִין אֶלָּא עַל הֶעְלֵם…","l":"3"},{"i":14,"s":7,"h":"אֵין בֵּית דִּין חַיָּיבִין עַד…","l":"3","c":1},{"i":15,"s":4,"h":"אֵין חַיָּיבִין עַל עֲשֵׂה וְעַל…","l":"4"},{"i":15,"s":17,"h":"אֵין חַיָּיבִין עַל שְׁמִיעַת קוֹל…","l":"5"},{"i":16,"s":15,"h":"כׇּל הַמִּצְוֹת שֶׁבְּתוֹרָה שֶׁחַיָּיבִין עַל…","l":"6–7"}]},{"n":3,"r":[{"i":17,"s":22,"h":"כֹּהֵן מָשִׁיחַ שֶׁחָטָא וְאַחַר כָּךְ…","l":"1–2"},{"i":18,"s":9,"h":"חָטְאוּ עַד שֶׁלֹּא נִתְמַנּוּ, וְאַחַר…","l":"3"},{"i":21,"s":9,"h":"וְאֵיזֶהוּ הַמָּשִׁיחַ?","l":"4"},{"i":23,"s":25,"h":"כֹּהֵן גָּדוֹל פּוֹרֵם מִלְּמַטָּה וְהַהֶדְיוֹט…","l":"5"},{"i":23,"s":32,"h":"כׇּל הַתָּדִיר מֵחֲבֵירוֹ קוֹדֵם אֶת…","l":"6"},{"i":24,"s":21,"h":"הָאִישׁ קוֹדֵם לָאִשָּׁה לְהַחֲיוֹת וּלְהָשֵׁב אֲבֵדָה.","l":"7"},{"i":24,"s":39,"h":"כֹּהֵן קוֹדֵם לְלֵוִי, לֵוִי לְיִשְׂרָאֵל…","l":"8"}]}]}
