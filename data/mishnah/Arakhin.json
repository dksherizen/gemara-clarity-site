{"m":"Arakhin","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"הַכֹּל מַעֲרִיכִין וְנֶעֱרָכִין, נוֹדְרִין וְנִידָּרִין…","l":"1"},{"i":8,"s":21,"h":"פָּחוֹת מִבֶּן חֹדֶשׁ נִידָּר, אֲבָל…","l":"1","c":1},{"i":9,"s":8,"h":"נָכְרִי רַבִּי מֵאִיר אוֹמֵר: נֶעֱרָךְ…","l":"2"},{"i":11,"s":11,"h":"הַגּוֹסֵס וְהַיּוֹצֵא לֵיהָרֵג לֹא נִידָּר…","l":"3"},{"i":12,"s":17,"h":"הָאִשָּׁה שֶׁיָּצְאָה לֵיהָרֵג, אֵין מַמְתִּינִין…","l":"4"}]},{"n":2,"r":[{"i":13,"s":20,"h":"אֵין נֶעֱרָכִין פָּחוֹת מִסֶּלַע, וְלֹא…","l":"1"},{"i":14,"s":6,"h":"אֵין ״פֶּתַח בְּטוֹעָה״ פָּחוֹת מִשִּׁבְעָה…","l":"1","c":1},{"i":15,"s":8,"h":"אֵין בִּנְגָעִים פָּחוֹת מִשָּׁבוּעַ אֶחָד…","l":"1","c":1},{"i":15,"s":17,"h":"אֵין פּוֹחֲתִין מֵאַרְבָּעָה חֳדָשִׁים הַמְעוּבָּרִים…","l":"2"},{"i":18,"s":3,"h":"אֵין פּוֹחֲתִין מֵעֶשְׂרִים וְאַחַת תְּקִיעוֹת…","l":"3–4"},{"i":24,"s":13,"h":"אֵין פּוֹחֲתִין מִשִּׁשָּׁה טְלָאִים הַמְבוּקָּרִין…","l":"5"},{"i":25,"s":10,"h":"אֵין פּוֹחֲתִין מִשְּׁנֵים עָשָׂר לְוִיִּם…","l":"6"}]},{"n":3,"r":[{"i":25,"s":26,"h":"יֵשׁ בַּעֲרָכִין לְהָקֵל וּלְהַחְמִיר, וּבִשְׂדֵה…","l":"1"},{"i":26,"s":7,"h":"בִּשְׂדֵה אֲחוּזָּה לְהָקֵל וּלְהַחֲמִיר, כֵּיצַד?","l":"2"},{"i":27,"s":23,"h":"בְּשׁוֹר הַמּוּעָד שֶׁהֵמִית אֶת הָעֶבֶד…","l":"3"},{"i":27,"s":26,"h":"בָּאוֹנֵס וּבַמְפַתֶּה לְהָקֵל וּלְהַחֲמִיר, כֵּיצַד?","l":"4"},{"i":28,"s":5,"h":"בְּמוֹצִיא שֵׁם רַע לְהָקֵל וּלְהַחֲמִיר, כֵּיצַד?","l":"5"}]},{"n":4,"r":[{"i":32,"s":10,"h":"הֶשֵּׂג יָד בַּנּוֹדֵר, וְהַשָּׁנִים בַּנִּידָּר…","l":"1–2"},{"i":33,"s":6,"h":"הָיָה עָנִי וְהֶעֱשִׁיר, עָשִׁיר וְהֶעֱנִי…","l":"2–3","c":1},{"i":34,"s":18,"h":"הַשָּׁנִים בַּנִּידָּר, כֵּיצַד?","l":"4"},{"i":34,"s":24,"h":"יוֹם שְׁלֹשִׁים כִּלְמַטָּה הֵימֶנּוּ שְׁנַת…","l":"4","c":1}]},{"n":5,"r":[{"i":36,"s":5,"h":"הָאוֹמֵר: ״מְשַׁקְּלִי עָלַי״ נוֹתֵן מִשְׁקָלוֹ…","l":"1"},{"i":37,"s":21,"h":"״דָּמֵי יְדֵי עָלַי״ שָׁמִין אוֹתוֹ…","l":"2"},{"i":38,"s":7,"h":"חוֹמֶר בָּעֲרָכִין מִבַּנְּדָרִים כֵּיצַד?","l":"2–4","c":1},{"i":39,"s":2,"h":"״שׁוֹר זֶה עוֹלָה״, וּ״בַיִת זֶה…","l":"5"},{"i":40,"s":11,"h":"חַיָּיבֵי עֲרָכִין מְמַשְׁכְּנִין אוֹתָן, חַיָּיבֵי…","l":"6"}]},{"n":6,"r":[{"i":41,"s":15,"h":"שׁוּם הַיְּתוֹמִים שְׁלֹשִׁים יוֹם וְשׁוּם…","l":"1"},{"i":44,"s":1,"h":"הַמַּקְדִּישׁ נְכָסָיו וְהָיְתָה עָלָיו כְּתוּבַּת…","l":"1","c":1},{"i":45,"s":12,"h":"הַמַּקְדִּישׁ נְכָסָיו, וְהָיְתָה עָלָיו כְּתוּבַּת…","l":"2"},{"i":45,"s":19,"h":"אַף עַל פִּי שֶׁאָמְרוּ חַיָּיבֵי…","l":"3–4"},{"i":46,"s":11,"h":"אֶחָד הַמַּקְדִּישׁ נְכָסָיו, וְאֶחָד הַמַּעֲרִיךְ…","l":"5"}]},{"n":7,"r":[{"i":46,"s":16,"h":"אֵין מַקְדִּישִׁין לִפְנֵי הַיּוֹבֵל פָּחוֹת…","l":"1"},{"i":48,"s":9,"h":"הַמַּקְדִּישׁ שָׂדֵהוּ בִּשְׁעַת הַיּוֹבֵל, נוֹתֵן…","l":"1–2","c":1},{"i":48,"s":24,"h":"הִקְדִּישָׁהּ וּגְאָלָהּ אֵינָהּ יוֹצְאָה מִיָּדוֹ…","l":"3"},{"i":49,"s":20,"h":"הִגִּיעַ יוֹבֵל וְלֹא נִגְאֲלָה, הַכֹּהֲנִים…","l":"4"},{"i":51,"s":20,"h":"הַלּוֹקֵחַ שָׂדֶה מֵאָבִיו, וּמֵת אָבִיו…","l":"5"}]},{"n":8,"r":[{"i":52,"s":10,"h":"הַמַּקְדִּישׁ אֶת שָׂדֵהוּ בְּשָׁעָה שֶׁאֵין…","l":"1"},{"i":52,"s":23,"h":"אָמַר אֶחָד: ״הֲרֵי הִיא שֶׁלִּי…","l":"2–3"},{"i":54,"s":2,"h":"מַחֲרִים אָדָם מִצֹּאנוֹ וּמִבְּקָרוֹ, וּמֵעֲבָדָיו…","l":"4"},{"i":54,"s":16,"h":"הַמַּחְרִים בְּנוֹ וּבִתּוֹ, וְעַבְדּוֹ וְשִׁפְחָתוֹ…","l":"5"},{"i":55,"s":16,"h":"חֶרְמֵי כֹּהֲנִים, אֵין לָהֶם פִּדְיוֹן…","l":"6–7"},{"i":56,"s":40,"h":"רַבִּי יִשְׁמָעֵאל אוֹמֵר: כָּתוּב אֶחָד…","l":"7","c":1}]},{"n":9,"r":[{"i":57,"s":1,"h":"הַמּוֹכֵר אֶת שָׂדֵהוּ בִּשְׁעַת הַיּוֹבֵל…","l":"1"},{"i":58,"s":11,"h":"מְכָרָהּ לָרִאשׁוֹן בְּמָנֶה, וּמָכַר רִאשׁוֹן…","l":"2"},{"i":60,"s":3,"h":"הַמּוֹכֵר בֵּית בְּבָתֵּי עָרֵי חוֹמָה…","l":"3–4"},{"i":61,"s":36,"h":"בָּרִאשׁוֹנָה הָיָה נִטְמָן יוֹם שְׁנֵים…","l":"4","c":1},{"i":62,"s":6,"h":"כׇּל שֶׁהוּא לִפְנִים מִן הַחוֹמָה…","l":"5"},{"i":62,"s":16,"h":"עִיר שֶׁגַּגּוֹתֶיהָ חוֹמָתָהּ, וְשֶׁאֵינָהּ מוּקֶּפֶת…","l":"6"},{"i":64,"s":11,"h":"בָּתֵּי הַחֲצֵרִים נוֹתְנִין לָהֶם כֹּחַ…","l":"7"},{"i":65,"s":1,"h":"וְאֵלּוּ הֵן בָּתֵּי הַחֲצֵרִים שְׁנֵי…","l":"7","c":1},{"i":65,"s":8,"h":"יִשְׂרָאֵל שֶׁיָּרַשׁ אֲבִי אִמּוֹ לֵוִי…","l":"8"},{"i":65,"s":18,"h":"אֵין עוֹשִׂין שָׂדֶה מִגְרָשׁ, וְלֹא…","l":"8","c":1}]}]}
