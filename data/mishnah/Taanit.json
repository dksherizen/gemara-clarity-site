{"m":"Taanit","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"מֵאֵימָתַי מַזְכִּירִין גְּבוּרוֹת גְּשָׁמִים?","l":"1–2"},{"i":8,"s":4,"h":"עַד מָתַי שׁוֹאֲלִין אֶת הַגְּשָׁמִים?","l":"2","c":1},{"i":18,"s":21,"h":"בִּשְׁלֹשָׁה בִּמְרַחְשְׁוָן שׁוֹאֲלִין אֶת הַגְּשָׁמִים.","l":"3"},{"i":18,"s":32,"h":"הִגִּיעַ שִׁבְעָה עָשָׂר בְּמַרְחֶשְׁוָן וְלֹא…","l":"4–5"},{"i":23,"s":20,"h":"עָבְרוּ אֵלּוּ וְלֹא נַעֲנוּ בֵּית…","l":"6–7"}]},{"n":2,"r":[{"i":28,"s":5,"h":"סֵדֶר תַּעֲנִיּוֹת כֵּיצַד?","l":"1–10"}]},{"n":3,"r":[{"i":35,"s":23,"h":"סֵדֶר תַּעֲנִיּוֹת אֵלּוּ הָאָמוּר בִּרְבִיעָה רִאשׁוֹנָה.","l":"1–9"}]},{"n":4,"r":[{"i":50,"s":5,"h":"בִּשְׁלֹשָׁה פְּרָקִים בְּשָׁנָה כֹּהֲנִים נוֹשְׂאִין…","l":"1–8"}]}]}
