{"m":"Moed_Katan","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"מַשְׁקִין בֵּית הַשְּׁלָחִין בַּמּוֹעֵד וּבַשְּׁבִיעִית…","l":"1–2"},{"i":11,"s":6,"h":"רַבִּי אֱלִיעֶזֶר בֶּן יַעֲקֹב אוֹמֵר…","l":"3"},{"i":11,"s":14,"h":"צָדִין אֶת הָאִישׁוּת וְאֶת הָעַכְבָּרִים…","l":"4"},{"i":12,"s":21,"h":"רַבִּי מֵאִיר אוֹמֵר: רוֹאִין אֶת…","l":"5"},{"i":14,"s":17,"h":"וְעוֹד אָמַר רַבִּי מֵאִיר: מְלַקֵּט…","l":"5","c":1},{"i":15,"s":4,"h":"אֵין חוֹפְרִין כּוּכִין וּקְבָרוֹת בַּמּוֹעֵד…","l":"6"},{"i":15,"s":18,"h":"אֵין נוֹשְׂאִין נָשִׁים בַּמּוֹעֵד, לֹא…","l":"7–8"},{"i":18,"s":18,"h":"מַעֲמִידִין תַּנּוּר וְכִירַיִם וְרֵיחַיִם בַּמּוֹעֵד.","l":"9"},{"i":20,"s":7,"h":"עוֹשִׂין מַעֲקֶה לַגַּג וְלַמִּרְפֶּסֶת מַעֲשֵׂה…","l":"10"}]},{"n":2,"r":[{"i":21,"s":1,"h":"מִי שֶׁהָפַךְ אֶת זֵיתָיו וְאֵירְעוֹ…","l":"1"},{"i":22,"s":18,"h":"וְכֵן מִי שֶׁהָיָה יֵינוֹ בְּתוֹךְ…","l":"2"},{"i":23,"s":36,"h":"מַכְנִיס אָדָם פֵּירוֹתָיו מִפְּנֵי הַגַּנָּבִים…","l":"3"},{"i":24,"s":7,"h":"אֵין לוֹקְחִין בָּתִּים עֲבָדִים וּבְהֵמָה…","l":"4"},{"i":24,"s":18,"h":"אֵין מְפַנִּין מִבַּיִת לְבַיִת, אֲבָל…","l":"4","c":1},{"i":25,"s":4,"h":"מְחַפִּין אֶת הַקְּצִיעוֹת בְּקַשׁ.","l":"5"}]},{"n":3,"r":[{"i":25,"s":20,"h":"וְאֵלּוּ מְגַלְּחִין בַּמּוֹעֵד: הַבָּא מִמְּדִינַת…","l":"1–2"},{"i":35,"s":5,"h":"וְאֵלּוּ כּוֹתְבִין בַּמּוֹעֵד: קִדּוּשֵׁי נָשִׁים…","l":"3"},{"i":35,"s":31,"h":"אֵין כּוֹתְבִין שְׁטָרֵי חוֹב בַּמּוֹעֵד.","l":"4"},{"i":36,"s":10,"h":"הַקּוֹבֵר אֶת מֵתוֹ שְׁלֹשָׁה יָמִים…","l":"5–6"},{"i":47,"s":20,"h":"אֵין קוֹרְעִין וְלֹא חוֹלְצִין וְאֵין…","l":"7"},{"i":52,"s":25,"h":"אֵין מוֹלִיכִין לְבֵית הָאֵבֶל, לֹא…","l":"7–8","c":1},{"i":55,"s":1,"h":"נָשִׁים בַּמּוֹעֵד מְעַנּוֹת, אֲבָל לֹא מְטַפְּחוֹת.","l":"8–9","c":1}]}]}
