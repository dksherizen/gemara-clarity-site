{"m":"Nazir","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"כׇּל כִּינּוּיֵי נְזִירוּת כִּנְזִירוּת.","l":"1"},{"i":5,"s":13,"h":"״הֲרֵינִי נָזִיר מִן הַחַרְצַנִּים״ וּ״מִן…","l":"2"},{"i":6,"s":13,"h":"״הֲרֵינִי כְּשִׁמְשׁוֹן״, ״כְּבֶן מָנוֹחַ״, ״כְּבַעַל…","l":"2","c":1},{"i":6,"s":17,"h":"מָה בֵּין נְזִיר עוֹלָם לְנָזִיר שִׁמְשׁוֹן?","l":"2","c":1},{"i":8,"s":23,"h":"סְתַם נְזִירוּת שְׁלֹשִׁים יוֹם."},{"i":12,"s":4,"h":"אָמַר: ״הֲרֵינִי נָזִיר אַחַת גְּדוֹלָה…","l":"3","c":1},{"i":12,"s":18,"h":"״הֲרֵינִי נָזִיר וְיוֹם אֶחָד״, ״הֲרֵינִי…","l":"3","c":1},{"i":13,"s":2,"h":"״הֲרֵינִי נָזִיר שְׁלֹשִׁים יוֹם וְשָׁעָה…","l":"3","c":1},{"i":14,"s":1,"h":"״הֲרֵינִי נָזִיר כִּשְׂעַר רֹאשִׁי״, וְ״כַעֲפַר…","l":"4–7"}]},{"n":2,"r":[{"i":16,"s":1,"h":"״הֲרֵינִי נָזִיר מִן הַגְּרוֹגְרוֹת וּמִן…","l":"1"},{"i":18,"s":2,"h":"אָמַר: ״אָמְרָה פָּרָה זוֹ הֲרֵינִי…","l":"2"},{"i":20,"s":1,"h":"מָזְגוּ לוֹ אֶת הַכּוֹס, וְאָמַר…","l":"3"},{"i":20,"s":9,"h":"״הֲרֵינִי נָזִיר עַל מְנָת שֶׁאֱהֵא…","l":"4"},{"i":21,"s":10,"h":"״הֲרֵינִי נָזִיר וְעָלַי לְגַלֵּחַ נָזִיר…","l":"5"},{"i":23,"s":10,"h":"״הֲרֵי עָלַי לְגַלֵּחַ חֲצִי נָזִיר…","l":"6"},{"i":23,"s":13,"h":"״הֲרֵינִי נָזִיר לִכְשֶׁיִּהְיֶה לִי בֵּן…","l":"7–8"},{"i":25,"s":3,"h":"״הֲרֵינִי נָזִיר, וְנָזִיר כְּשֶׁיִּהְיֶה לִי…","l":"9"},{"i":28,"s":4,"h":"״הֲרֵינִי נָזִיר לִכְשֶׁיְּהֵא לִי בֵּן…","l":"10"}]},{"n":3,"r":[{"i":30,"s":8,"h":"מִי שֶׁאָמַר ״הֲרֵינִי נָזִיר״ מְגַלֵּחַ…","l":"1–4"},{"i":31,"s":4,"h":"מִי שֶׁנָּזַר וְהוּא בְּבֵית הַקְּבָרוֹת…","l":"5"},{"i":37,"s":9,"h":"מִי שֶׁנָּזַר נְזִירוּת הַרְבֵּה, וְהִשְׁלִים…","l":"6"},{"i":38,"s":6,"h":"מִי שֶׁהָיוּ שְׁתֵּי כִּיתֵּי עֵדִים…","l":"7"}]},{"n":4,"r":[{"i":39,"s":4,"h":"מִי שֶׁאָמַר ״הֲרֵינִי נָזִיר״ וְשָׁמַע…","l":"1–2"},{"i":44,"s":2,"h":"הָאִשָּׁה שֶׁנָּדְרָה בְּנָזִיר, וְהָיְתָה שׁוֹתֶה…","l":"3"},{"i":46,"s":2,"h":"הָאִשָּׁה שֶׁנָּדְרָה בְּנָזִיר, וְהִפְרִישָׁה אֶת…","l":"4"},{"i":54,"s":12,"h":"נִזְרַק עָלֶיהָ אֶחָד מִן הַדָּמִים…","l":"5"},{"i":55,"s":12,"h":"הָאִיש