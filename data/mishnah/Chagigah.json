{"m":"Chagigah","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"הַכֹּל חַיָּיבִין בִּרְאִיָּיה, חוּץ מֵחֵרֵשׁ…","l":"1–2"},{"i":13,"s":4,"h":"עוֹלוֹת בַּמּוֹעֵד בָּאוֹת מִן הַחוּלִּין…","l":"3–4"},{"i":15,"s":5,"h":"מִי שֶׁיֵּשׁ לוֹ אוֹכְלִים מְרוּבִּים…","l":"5"},{"i":16,"s":4,"h":"מִי שֶׁלֹּא חָג בְּיוֹם טוֹב…","l":"6–7"},{"i":18,"s":6,"h":"הֶיתֵּר נְדָרִים פּוֹרְחִין בָּאֲוִיר וְאֵין…","l":"8"}]},{"n":2,"r":[{"i":21,"s":7,"h":"אֵין דּוֹרְשִׁין בָּעֲרָיוֹת בִּשְׁלֹשָׁה, וְלֹא…","l":"1"},{"i":30,"s":32,"h":"יוֹסֵי בֶּן יוֹעֶזֶר אוֹמֵר שֶׁלֹּא…","l":"2"},{"i":32,"s":2,"h":"בֵּית שַׁמַּאי אוֹמְרִים: מְבִיאִין שְׁלָמִים…","l":"3–4"},{"i":35,"s":1,"h":"נוֹטְלִין לַיָּדַיִם לַחוּלִּין וְלַמַּעֲשֵׂר וְלַתְּרוּמָה…","l":"5–7"}]},{"n":3,"r":[{"i":39,"s":11,"h":"חוֹמֶר בַּקֹּדֶשׁ מִבִּתְרוּמָה, שֶׁמַּטְבִּילִין כֵּלִים…","l":"1–3"},{"i":47,"s":18,"h":"חוֹמֶר בַּתְּרוּמָה, שֶׁבִּיהוּדָה נֶאֱמָנִין עַל…","l":"4"},{"i":49,"s":29,"h":"מִן הַמּוֹדִיעִים וְלִפְנִים נֶאֱמָנִין עַל…","l":"5"},{"i":50,"s":10,"h":"הַגַּבָּאִין שֶׁנִּכְנְסוּ לְתוֹךְ הַבַּיִת, וְכֵן…","l":"6"},{"i":50,"s":26,"h":"הַפּוֹתֵחַ אֶת חָבִיתוֹ, וְהַמַּתְחִיל בְּעִיסָּתוֹ…","l":"7"},{"i":50,"s":35,"h":"מִשֶּׁעָבַר הָרֶגֶל מַעֲבִירִין עַל טׇהֳרַת הָעֲזָרָה.","l":"7","c":1},{"i":50,"s":39,"h":"כֵּיצַד מַעֲבִירִין עַל טׇהֳרַת עֲזָרָה?","l":"8"}]}]}
