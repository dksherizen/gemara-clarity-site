{"m":"Temurah","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"הַכֹּל מְמִירִין אֶחָד אֲנָשִׁים וְאֶחָד…","l":"1"},{"i":13,"s":24,"h":"הַכֹּהֲנִים מְמִירִין בְּשֶׁלָּהֶן, וְיִשְׂרָאֵל מְמִירִין בְּשֶׁלָּהֶן."},{"i":16,"s":2,"h":"מְמִירִין מִן הַצֹּאן עַל הַבָּקָר…"},{"i":16,"s":23,"h":"מְמִירִין אֶחָד בִּשְׁנַיִם, וּשְׁנַיִם בְּאֶחָד…","l":"2","c":1},{"i":18,"s":15,"h":"אֵין מְמִירִין, לֹא אֵבָרִין בְּעוּבָּרִין…","l":"3"},{"i":22,"s":5,"h":"אֵין הַמְדוּמָּע מְדַמֵּעַ, אֶלָּא לְפִי חֶשְׁבּוֹן.","l":"4–5"},{"i":24,"s":12,"h":"הָעוֹפוֹת וְהַמְּנָחוֹת אֵין עוֹשִׂין תְּמוּרָה…","l":"6"}]},{"n":2,"r":[{"i":26,"s":1,"h":"יֵשׁ בְּקׇרְבְּנוֹת יָחִיד שֶׁאֵין בְּקׇרְבְּנוֹת…","l":"1"},{"i":28,"s":2,"h":"חַטַּאת הַיָּחִיד שֶׁכִּפְּרוּ בְּעָלֶיהָ מֵתָה…","l":"2"},{"i":31,"s":10,"h":"חוֹמֶר בַּקֳּדָשִׁים מִבַּתְּמוּרָה, וְחוֹמֶר בַּתְּמוּרָה מִבַּקֳּדָשִׁים.","l":"3"}]},{"n":3,"r":[{"i":33,"s":3,"h":"אֵלּוּ קָדָשִׁים שֶׁוַּולְדוֹתֵיהֶן וּתְמוּרוֹתֵיהֶן כַּיּוֹצֵא…","l":"1"},{"i":34,"s":17,"h":"רַבִּי אֱלִיעֶזֶר אוֹמֵר: וְלַד שְׁלָמִים…","l":"1","c":1},{"i":35,"s":14,"h":"וְלַד תּוֹדָה וּתְמוּרָתָהּ, וְלָדָן וְלַד…","l":"2"},{"i":35,"s":20,"h":"תְּמוּרַת עוֹלָה, וְלַד תְּמוּרָה, וְלַד…","l":"2–3","c":1},{"i":37,"s":6,"h":"הַמַּפְרִישׁ נְקֵבָה לְאָשָׁם תִּרְעֶה עַד…","l":"3","c":1},{"i":39,"s":4,"h":"תְּמוּרַת אָשָׁם, וְלַד תְּמוּרָה, וְלָדָן…","l":"3–4","c":1},{"i":40,"s":5,"h":"תְּמוּרַת הַבְּכוֹר וְהַמַּעֲשֵׂר, וְלָדָן וְלַד…","l":"5"}]},{"n":4,"r":[{"i":41,"s":25,"h":"וְלַד חַטָּאת, וּתְמוּרַת חַטָּאת, וְחַטָּאת…","l":"1"},{"i":43,"s":22,"h":"הַמַּפְרִישׁ חַטָּאת, וְאָבְדָה, וְהִפְרִישׁ אַחֶרֶת…","l":"2–4"}]},{"n":5,"r":[{"i":47,"s":1,"h":"כֵּיצַד מַעֲרִימִין עַל הַבְּכוֹר?","l":"1–2"},{"i":48,"s":19,"h":"הָאוֹמֵר ״וְלָדָהּ שֶׁל זוֹ עוֹלָה…","l":"3"},{"i":49,"s":18,"h":"״הֲרֵי זוֹ תְּמוּרַת עוֹלָה תְּמוּרַת…","l":"4"},{"i":51,"s":7,"h":"״הֲרֵי זוֹ תַּחַת זוֹ״, ״תְּמוּרַת…","l":"5"},{"i":53,"s":14,"h":"״הֲרֵי זוֹ תַּחַת עוֹלָה״, ״תַּחַת…","l":"6"}]},{"n":6,"r":[{"i":54,"s":1,"h":"כָּל הָאֲסוּרִין לְגַבֵּי מִזְבֵּחַ אוֹסְרִין…","l":"1"},{"i":56,"s":20,"h":"וְאֵיזֶהוּ אֶתְנַן?","l":"2"},{"i":58,"s":11,"h":"וְאֵיזֶהוּ ״מְחִיר כֶּלֶב״?","l":"3"},{"i":59,"s":12,"h":"נָתַן לָהּ מָעוֹת הֲרֵי אֵלּוּ מוּתָּרִין.","l":"4–5"}]},{"n":7,"r":[{"i":60,"s":18,"h":"יֵשׁ בְּקׇדְשֵׁי מִזְבֵּחַ שֶׁאֵין בְּקׇדְשֵׁי…","l":"1–2"},{"i":62,"s":1,"h":"אֶחָד קׇדְשֵׁי מִזְבֵּחַ וְאֶחָד קׇדְשֵׁי…","l":"3"},{"i":65,"s":17,"h":"וְאֵלּוּ הֵן הַנִּקְבָּרִין: קָדָשִׁים שֶׁהִפִּילוּ…","l":"4–6"}]}]}
