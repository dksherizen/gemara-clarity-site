{"m":"Megillah","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"מְגִילָּה נִקְרֵאת בְּאַחַד עָשָׂר, בִּשְׁנֵים…","l":"1–2"},{"i":8,"s":10,"h":"אִי זוֹ הִיא עִיר גְּדוֹלָה…","l":"3"},{"i":11,"s":15,"h":"קָרְאוּ אֶת הַמְּגִילָּה בַּאֲדָר הָרִאשׁוֹן…","l":"4"},{"i":13,"s":16,"h":"אֵין בֵּין יוֹם טוֹב לַשַּׁבָּת…","l":"5"},{"i":13,"s":25,"h":"אֵין בֵּין שַׁבָּת לְיוֹם הַכִּפּוּרִים…","l":"5","c":1},{"i":14,"s":1,"h":"אֵין בֵּין הַמּוּדָּר הֲנָאָה מֵחֲבֵירוֹ…","l":"6"},{"i":14,"s":5,"h":"אֵין בֵּין נְדָרִים לִנְדָבוֹת, אֶלָּא…","l":"6","c":1},{"i":14,"s":12,"h":"אֵין בֵּין זָב הָרוֹאֶה שְׁתֵּי…","l":"7"},{"i":15,"s":8,"h":"אֵין בֵּין מְצוֹרָע מוּסְגָּר לִמְצוֹרָע…","l":"7","c":1},{"i":15,"s":22,"h":"אֵין בֵּין סְפָרִים לִתְפִלִּין וּמְזוּזוֹת…","l":"8"},{"i":17,"s":11,"h":"אֵין בֵּין כֹּהֵן מָשׁוּחַ בְּשֶׁמֶן…","l":"9"},{"i":17,"s":24,"h":"אֵין בֵּין בָּמָה גְּדוֹלָה לַבָּמָה…","l":"10"},{"i":17,"s":29,"h":"אֵין בֵּין שִׁילֹה לִירוּשָׁלַיִם, אֶלָּא…","l":"11"}]},{"n":2,"r":[{"i":32,"s":18,"h":"הַקּוֹרֵא אֶת הַמְּגִילָּה לְמַפְרֵעַ לֹא יָצָא.","l":"1–2"},{"i":36,"s":5,"h":"בֶּן עִיר שֶׁהָלַךְ לִכְרַךְ וּבֶן…","l":"3"},{"i":37,"s":8,"h":"הַכֹּל כְּשֵׁרִין לִקְרוֹת אֶת הַמְּגִילָּה…","l":"4"},{"i":38,"s":12,"h":"אֵין קוֹרִין אֶת הַמְּגִילָּה, וְלֹא…","l":"4","c":1},{"i":39,"s":9,"h":"כׇּל הַיּוֹם כָּשֵׁר לִקְרִיאַת הַמְּגִילָּה…","l":"5–6"}]},{"n":3,"r":[{"i":40,"s":14,"h":"הַקּוֹרֵא אֶת הַמְּגִילָּה עוֹמֵד וְיוֹשֵׁב.","l":"4:1–2"},{"i":45,"s":7,"h":"אֵין פּוֹרְסִין עַל שְׁמַע, וְאֵין…","l":"4:3"},{"i":45,"s":28,"h":"הַקּוֹרֵא בְּתוֹרָה לֹא יִפְחוֹת מִשְּׁלֹשָׁה…","l":"4:4"},{"i":46,"s":14,"h":"הַמַּפְטִיר בַּנָּבִיא הוּא פּוֹרֵס עַל…","l":"4:5–6"},{"i":47,"s":11,"h":"כֹּהֵן שֶׁיֵּשׁ בְּיָדָיו מוּמִין לֹא…","l":"4:7"},{"i":47,"s":29,"h":"הָאוֹמֵר: אֵינִי עוֹבֵר לִפְנֵי הַתֵּיבָה…","l":"4:8"},{"i":47,"s":37,"h":"הָאוֹמֵר: ״יְבָרְכוּךָ טוֹבִים״ הֲרֵי זוֹ…","l":"4:9"},{"i":48,"s":25,"h":"מַעֲשֵׂה רְאוּבֵן נִקְרָא וְלֹא מִתַּרְגֵּם.","l":"4:10"}]},{"n":4,"r":[{"i":49,"s":46,"h":"בְּנֵ