{"m":"Eruvin","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"מָבוֹי שֶׁהוּא גָּבוֹהַּ לְמַעְלָה מֵעֶשְׂרִים…","l":"1"},{"i":21,"s":29,"h":"הֶכְשֵׁר מָבוֹי, בֵּית שַׁמַּאי אוֹמְרִים…","l":"2"},{"i":25,"s":20,"h":"הַקּוֹרָה שֶׁאָמְרוּ רְחָבָה כְּדֵי לְקַבֵּל אָרִיחַ.","l":"3–5"},{"i":27,"s":13,"h":"לְחָיַיִן שֶׁאָמְרוּ גּוֹבְהָן עֲשָׂרָה טְפָחִים…","l":"6"},{"i":28,"s":33,"h":"בַּכֹּל עוֹשִׂין לְחָיַיִן אֲפִילּוּ בְּדָבָר…","l":"7"},{"i":29,"s":16,"h":"שְׁיָירָא שֶׁחָנְתָה בְּבִקְעָה וְהִקִּיפוּהָ כְּלֵי…","l":"8"},{"i":31,"s":11,"h":"מַקִּיפִין שְׁלֹשָׁה חֲבָלִים זֶה לְמַעְלָה…","l":"9–10"},{"i":32,"s":18,"h":"אַרְבָּעָה דְּבָרִים פָּטְרוּ בַּמַּחֲנֶה: מְבִיאִין…","l":"10","c":1}]},{"n":2,"r":[{"i":33,"s":19,"h":"עוֹשִׂין פַּסִּין לְבֵירָאוֹת.","l":"1–3"},{"i":42,"s":22,"h":"רַבִּי יְהוּדָה אוֹמֵר: אִם הָיָה…","l":"4"},{"i":43,"s":26,"h":"אֶחָד בּוֹר הָרַבִּים וּבְאֵר הָרַבִּים…","l":"4","c":1},{"i":44,"s":6,"h":"וְעוֹד אָמַר רַבִּי יְהוּדָה בֶּן…","l":"5–6"}]},{"n":3,"r":[{"i":51,"s":20,"h":"בַּכֹּל מְעָרְבִין וּמִשְׁתַּתְּפִין, חוּץ מִן…","l":"1"},{"i":60,"s":18,"h":"מְעָרְבִין בִּדְמַאי, וּבְמַעֲשֵׂר רִאשׁוֹן שֶׁנִּטְּלָה…","l":"2"},{"i":61,"s":21,"h":"הַשּׁוֹלֵחַ עֵירוּבוֹ בְּיַד חֵרֵשׁ שׁוֹטֶה…","l":"2","c":1},{"i":63,"s":6,"h":"נְתָנוֹ בְּאִילָן, לְמַעְלָה מֵעֲשָׂרָה טְפָחִים…","l":"3"},{"i":67,"s":6,"h":"נְתָנוֹ בְּרֹאשׁ הַקָּנֶה אוֹ בְּרֹאשׁ…","l":"3","c":1},{"i":67,"s":17,"h":"נְתָנוֹ בְּמִגְדָּל וְאָבַד הַמַּפְתֵּחַ הֲרֵי…","l":"3","c":1},{"i":68,"s":13,"h":"נִתְגַּלְגֵּל חוּץ לַתְּחוּם, נָפַל עָלָיו…","l":"4"},{"i":71,"s":3,"h":"מַתְנֶה אָדָם עַל עֵירוּבוֹ, וְאוֹמֵר…","l":"5"},{"i":74,"s":3,"h":"רַבִּי אֱלִיעֶזֶר אוֹמֵר: יוֹם טוֹב…","l":"6"},{"i":76,"s":9,"h":"רַבִּי יְהוּדָה אוֹמֵר: רֹאשׁ הַשָּׁנָה…","l":"7–9"}]},{"n":4,"r":[{"i":81,"s":6,"h":"מִי שֶׁהוֹצִיאוּהוּ נׇכְרִים, אוֹ רוּחַ…","l":"1–2"},{"i":87,"s":10,"h":"מִי שֶׁיָּצָא בִּרְשׁוּת, וְאָמְרוּ לוֹ…","l":"3"},{"i":88,"s":26,"h":"מִי שֶׁיָּשַׁב בַּדֶּרֶךְ, וְעָמַד וְרָאָה…","l":"4"},{"i":88,"s":31,"h":"מִי שֶׁיָּשַׁן בַּדֶּרֶךְ וְלָא יָדַע…","l":"5–6"},{"i":97,"s":5,"h":"מִי שֶׁבָּא בְּדֶרֶךְ וְחָשְׁכָה לוֹ…","l":"7–9"},{"i":102,"s":9,"h":"מִי שֶׁיָּצָא לֵילֵךְ בְּעִיר שֶׁמְּעָרְבִין…","l":"10"},{"i":103,"s":7,"h":"מִי שֶׁיָּצָא חוּץ לַתְּחוּם אֲפִילּוּ…","l":"11"},{"i":103,"s":19,"h":"מִי שֶׁהֶחֱשִׁיךְ חוּץ לַתְּחוּם אֲפִילּוּ…","l":"11","c":1}]},{"n":5,"r":[{"i":103,"s":23,"h":"כֵּיצַד מְעַבְּרִין אֶת הֶעָרִים?","l":"1"},{"i":112,"s":14,"h":"נוֹתְנִין קַרְפֵּף לָעִיר, דִּבְרֵי רַבִּי מֵאִיר.","l":"2–3"},{"i":113,"s":20,"h":"אֵין מוֹדְדִין אֶלָּא בְּחֶבֶל שֶׁל…","l":"4"},{"i":115,"s":20,"h":"אֵין מוֹדְדִין אֶלָּא מִן הַמּוּמְחֶה.","l":"5"},{"i":116,"s":8,"h":"עִיר שֶׁל יָחִיד, וְנַעֲשֵׂית שֶׁל…","l":"6"},{"i":118,"s":31,"h":"מִי שֶׁהָיָה בַּמִּזְרָח וְאָמַר לִבְנוֹ…","l":"7"},{"i":120,"s":23,"h":"אַנְשֵׁי עִיר גְּדוֹלָה מְהַלְּכִין אֶת…","l":"8–9"}]},{"n":6,"r":[{"i":121,"s":14,"h":"הַדָּר עִם הַנׇּכְרִי בֶּחָצֵר, אוֹ…","l":"1–2"},{"i":137,"s":13,"h":"אַנְשֵׁי חָצֵר שֶׁשָּׁכַח אֶחָד מֵהֶן…","l":"3–4"},{"i":140,"s":17,"h":"בַּעַל הַבַּיִת שֶׁהָיָה שׁוּתָּף לִשְׁכֵנָיו…","l":"5"},{"i":142,"s":5,"h":"חֲמִשָּׁה חֲבוּרוֹת שֶׁשָּׁבְתוּ בִּטְרַקְלִין אֶחָד…","l":"6–7"},{"i":143,"s":16,"h":"הָאַחִין שֶׁהָיוּ אוֹכְלִין עַל שֻׁלְחָן…","l":"7","c":1},{"i":144,"s":24,"h":"חָמֵשׁ חֲצֵירוֹת פְּתוּחוֹת זוֹ לָזוֹ…","l":"8"},{"i":148,"s":5,"h":"שְׁתֵּי חֲצֵירוֹת זוֹ לִפְנִים מִזּוֹ…","l":"9–10"}]},{"n":7,"r":[{"i":150,"s":7,"h":"חַלּוֹן שֶׁבֵּין שְׁתֵּי חֲצֵירוֹת אַרְבָּעָה…","l":"1"},{"i":151,"s":16,"h":"כּוֹתֶל שֶׁבֵּין שְׁתֵּי חֲצֵירוֹת, גָּבוֹהַּ…","l":"2"},{"i":155,"s":19,"h":"חָרִיץ שֶׁבֵּין שְׁתֵּי חֲצֵירוֹת, עָמוֹק…","l":"3–4"},{"i":156,"s":11,"h":"מַתְבֵּן שֶׁבֵּין שְׁתֵּי חֲצֵירוֹת גָּבוֹהַּ…","l":"5"},{"i":157,"s":16,"h":"כֵּיצַד מִשְׁתַּתְּפִין בְּמָבוֹי?","l":"6"},{"i":159,"s":5,"h":"נִתְמַעֵט הָאוֹכֶל מוֹסִיף וּמְזַכֶּה, וְאֵין…","l":"7–9"},{"i":159,"s":27,"h":"בַּכֹּל מְעָרְבִין וּמִשְׁתַּתְּפִין, חוּץ מִן…","l":"10"},{"i":160,"s":25,"h":"נוֹתֵן אָדָם מָעָה לַחֶנְוָנִי וְלַנַּחְתּוֹם…","l":"11"}]},{"n":8,"r":[{"i":162,"s":11,"h":"כֵּיצַד מִשְׁתַּתְּפִין בִּתְחוּמִין?","l":"1"},{"i":163,"s":18,"h":"כַּמָּה הוּא שִׁיעוּרוֹ?","l":"2"},{"i":165,"s":7,"h":"אַנְשֵׁי חָצֵר וְאַנְשֵׁי מִרְפֶּסֶת שֶׁשָּׁכְחוּ…","l":"3"},{"i":169,"s":10,"h":"הַנּוֹתֵן אֶת עֵירוּבוֹ בְּבֵית שַׁעַר…","l":"4"},{"i":170,"s":8,"h":"הַמַּנִּיחַ בֵּיתוֹ וְהָלַךְ לִשְׁבּוֹת בְּעִיר…","l":"5"},{"i":170,"s":15,"h":"בּוֹר שֶׁבֵּין שְׁתֵּי חֲצֵירוֹת אֵין…","l":"6"},{"i":172,"s":9,"h":"אַמַּת הַמַּיִם שֶׁהִיא עוֹבֶרֶת בֶּחָצֵר…","l":"7"},{"i":173,"s":17,"h":"גְּזוּזְטְרָא שֶׁהִיא לְמַעְלָה מִן הַמַּיִם…","l":"8"},{"i":174,"s":20,"h":"חָצֵר שֶׁהִיא פְּחוּתָה מֵאַרְבַּע אַמּוֹת…","l":"9–11"}]},{"n":9,"r":[{"i":176,"s":5,"h":"כָּל גַּגּוֹת הָעִיר רְשׁוּת אַחַת…","l":"1"},{"i":182,"s":12,"h":"גַּג גָּדוֹל סָמוּךְ לְקָטָן הַגָּדוֹל…","l":"2"},{"i":186,"s":11,"h":"חָצֵר שֶׁנִּפְרְצָה לִרְשׁוּת הָרַבִּים הַמַּכְנִיס…","l":"2","c":1},{"i":186,"s":27,"h":"חָצֵר שֶׁנִּפְרְצָה לִרְשׁוּת הָרַבִּים מִשְׁתֵּי…","l":"3"},{"i":188,"s":16,"h":"הַבּוֹנֶה עֲלִיָּיה עַל גַּבֵּי שְׁנֵי…","l":"4"}]},{"n":10,"r":[{"i":188,"s":26,"h":"הַמּוֹצֵא תְּפִילִּין מַכְנִיסָן זוּג זוּג.","l":"1–2"},{"i":193,"s":25,"h":"הָיָה קוֹרֵא בְּסֵפֶר עַל הָאִיסְקוּפָּה…","l":"3"},{"i":195,"s":6,"h":"זִיז שֶׁלִּפְנֵי חַלּוֹן נוֹתְנִין עָלָיו…","l":"4"},{"i":195,"s":13,"h":"עוֹמֵד אָדָם בִּרְשׁוּת הַיָּחִיד וּמְטַלְטֵל…","l":"4–5","c":1},{"i":196,"s":27,"h":"לֹא יַעֲמוֹד אָדָם בִּרְשׁוּת הַיָּחִיד…","l":"6"},{"i":197,"s":6,"h":"קוֹלֵט אָדָם מִן הַמַּזְחֵילָה לְמַטָּה…","l":"6","c":1},{"i":197,"s":12,"h":"בּוֹר בִּרְשׁוּת הָרַבִּים וְחוּלְיָיתוֹ גָּבוֹהַּ…","l":"7"},{"i":197,"s":23,"h":"אִילָן שֶׁהָיָה מֵיסֵךְ עַל הָאָרֶץ…","l":"8"},{"i":200,"s":1,"h":"הַדֶּלֶת שֶׁבַּמּוּקְצֶה, וַחֲדָקִים שֶׁבַּפִּרְצָה, וּמַחְצָלוֹת…","l":"8","c":1},{"i":200,"s":18,"h":"לֹא יַעֲמוֹד אָדָם בִּרְשׁוּת הַיָּחִיד…","l":"9"},{"i":201,"s":17,"h":"נֶגֶר שֶׁיֵּשׁ בְּרֹאשׁוֹ גְּלוֹסְטְרָא, רַבִּי…","l":"10"},{"i":202,"s":2,"h":"נֶגֶר הַנ