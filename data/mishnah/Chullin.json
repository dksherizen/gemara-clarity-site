{"m":"Chullin","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"הַכֹּל שׁוֹחֲטִין וּשְׁחִיטָתָן כְּשֵׁרָה, חוּץ…","l":"1"},{"i":24,"s":16,"h":"שְׁחִיטַת נׇכְרִי נְבֵלָה, וּמְטַמְּאָה בְּמַשָּׂא.","l":"1","c":1},{"i":25,"s":19,"h":"הַשּׁוֹחֵט בַּלַּיְלָה, וְכֵן הַסּוֹמֵא שֶׁשָּׁחַט…","l":"1","c":1},{"i":26,"s":1,"h":"הַשּׁוֹחֵט בְּשַׁבָּת וּבְיוֹם הַכִּיפּוּרִים, אַף…","l":"1","c":1},{"i":29,"s":10,"h":"הַשּׁוֹחֵט בְּמַגַּל יָד, בְּצוֹר, וּבְקָנֶה…","l":"2"},{"i":34,"s":18,"h":"הַשּׁוֹחֵט בְּמַגַּל קָצִיר, בַּדֶּרֶךְ הֲלִיכָתָהּ…","l":"2","c":1},{"i":34,"s":23,"h":"הַשּׁוֹחֵט מִתּוֹךְ הַטַּבַּעַת, וְשִׁיֵּיר בָּהּ…","l":"3"},{"i":37,"s":16,"h":"הַשּׁוֹחֵט מִן הַצְּדָדִין שְׁחִיטָתוֹ כְּשֵׁרָה…","l":"4"},{"i":42,"s":17,"h":"כָּשֵׁר בְּתוֹרִין פָּסוּל בִּבְנֵי יוֹנָה…","l":"5"},{"i":45,"s":13,"h":"כָּשֵׁר בַּפָּרָה פָּסוּל בָּעֶגְלָה, כָּשֵׁר…","l":"6"},{"i":46,"s":8,"h":"כָּשֵׁר בַּכֹּהֲנִים פָּסוּל בַּלְוִיִּם, כָּשֵׁר…","l":"6","c":1},{"i":47,"s":20,"h":"טָהוֹר בִּכְלִי חֶרֶשׂ טָמֵא בְּכׇל…","l":"6","c":1},{"i":48,"s":10,"h":"טָהוֹר בִּכְלֵי עֵץ, טָמֵא בִּכְלֵי…","l":"6","c":1},{"i":49,"s":12,"h":"הַחַיָּיב בִּשְׁקֵדִים הַמָּרִים פָּטוּר בַּמְּתוּקִים…","l":"6","c":1},{"i":49,"s":18,"h":"הַתֶּמֶד, עַד שֶׁלֹּא הֶחְמִיץ אֵינוֹ…","l":"7"},{"i":51,"s":5,"h":"כׇּל מָקוֹם שֶׁיֵּשׁ מֶכֶר, אֵין…","l":"7","c":1},{"i":51,"s":11,"h":"כׇּל מָקוֹם שֶׁיֵּשׁ מֵיאוּן אֵין…","l":"7","c":1},{"i":51,"s":14,"h":"כׇּל מָקוֹם שֶׁיֵּשׁ תְּקִיעָה אֵין…","l":"7","c":1}]},{"n":2,"r":[{"i":52,"s":1,"h":"הַשּׁוֹחֵט אֶחָד בָּעוֹף וּשְׁנַיִם בַּבְּהֵמָה…","l":"1"},{"i":59,"s":12,"h":"הַשּׁוֹחֵט שְׁנֵי רָאשִׁין כְּאֶחָד שְׁחִיטָתוֹ כְּשֵׁרָה.","l":"2–3"},{"i":60,"s":21,"h":"נָפְלָה סַכִּין וְשָׁחֲטָה, אַף עַל…","l":"3","c":1},{"i":62,"s":5,"h":"נָפְלָה סַכִּין וְהִגְבִּיהָהּ, נָפְלוּ כֵּלָיו…","l":"3","c":1},{"i":62,"s":26,"h":"שָׁחַט אֶת הַוֶּושֶׁט, וּפָסַק אֶת…","l":"4"},{"i":64,"s":9,"h":"הַשּׁוֹחֵט בְּהֵמָה חַיָּה וָעוֹף וְלֹא…","l":"5"},{"i":72,"s":3,"h":"הַשּׁוֹחֵט אֶת הַמְסוּכֶּנֶת, רַבָּן שִׁמְעוֹן…","l":"6"},{"i":75,"s":10,"h":"הַשּׁוֹחֵט לְנׇכְרִי שְׁחִיטָתוֹ כְּשֵׁרָה, וְרַבִּי…","l":"7"},{"i":77,"s":24,"h":"הַשּׁוֹחֵט לְשֵׁם הָרִים, לְשֵׁם גְּבָעוֹת…","l":"8"},{"i":80,"s":16,"h":"אֵין שׁוֹחֲטִין לֹא לְתוֹךְ יַמִּים…","l":"9"},{"i":81,"s":10,"h":"הַשּׁוֹחֵט לְשֵׁם עוֹלָה, לְשֵׁם זְבָחִים…","l":"10"}]},{"n":3,"r":[{"i":82,"s":3,"h":"אֵלּוּ טְרֵפוֹת בַּבְּהֵמָה: נְקוּבַת הַוֶּושֶׁט…","l":"1"},{"i":106,"s":21,"h":"וְאֵלּוּ כְּשֵׁרוֹת בַּבְּהֵמָה, נִיקְּבָה הַגַּרְגֶּרֶת…","l":"2"},{"i":110,"s":2,"h":"וְאֵלּוּ טְרֵפוֹת בָּעוֹף: נְקוּבַת הַוֶּושֶׁט…","l":"3"},{"i":111,"s":20,"h":"וְאֵלּוּ כְּשֵׁרוֹת בָּעוֹף: נִיקְּבָה הַגַּרְגֶּרֶת…","l":"4"},{"i":115,"s":23,"h":"אֲחוּזַת הַדָּם, וְהַמְעוּשֶּׁנֶת, וְהַמְצוּנֶּנֶת, וְשֶׁאָכְלָה…","l":"5"},{"i":116,"s":11,"h":"סִימָנֵי בְּהֵמָה וְחַיָּה נֶאֶמְרוּ מִן…","l":"6–7"}]},{"n":4,"r":[{"i":134,"s":1,"h":"בְּהֵמָה הַמְקַשָּׁה לֵילֵד, וְהוֹצִיא הָעוּבָּר…","l":"1"},{"i":137,"s":12,"h":"הַמְבַכֶּרֶת, הַמְקַשָּׁה לֵילֵד מְחַתֵּךְ אֵבֶר…","l":"2"},{"i":139,"s":1,"h":"בְּהֵמָה שֶׁמֵּת עוּבָּרָהּ בְּתוֹךְ מֵעֶיהָ…","l":"3"},{"i":140,"s":17,"h":"הָאִשָּׁה שֶׁמֵּת וְלָדָהּ בְּתוֹךְ מֵעֶיהָ…","l":"3","c":1},{"i":142,"s":22,"h":"בְּהֵמָה הַמְקַשָּׁה לֵילֵד, וְהוֹצִיא עוּבָּר…","l":"4"},{"i":146,"s":25,"h":"הַשּׁוֹחֵט אֶת הַבְּהֵמָה, וּמָצָא בָּהּ…","l":"5"},{"i":150,"s":1,"h":"בְּהֵמָה שֶׁנֶּחְתְּכוּ רַגְלֶיהָ מִן הָאַרְכּוּבָּה…","l":"6"},{"i":152,"s":16,"h":"הַשּׁוֹחֵט אֶת הַבְּהֵמָה וּמָצָא בָּהּ…","l":"7"}]},{"n":5,"r":[{"i":154,"s":6,"h":"אוֹתוֹ וְאֶת בְּנוֹ נוֹהֵג בֵּין…","l":"1–2"},{"i":161,"s":4,"h":"הַשּׁוֹחֵט וְנִמְצָא טְרֵפָה, הַשּׁוֹחֵט לַעֲבוֹדָה…","l":"3"},{"i":162,"s":12,"h":"שְׁנַיִם שֶׁלָּקְחוּ פָּרָה וּבְנָהּ, אֵיזֶה…","l":"3","c":1},{"i":162,"s":15,"h":"שָׁחַט פָּרָה וְאַחַר כָּךְ שְׁנֵי…","l":"3","c":1},{"i":164,"s":10,"h":"בְּאַרְבָּעָה פְּרָקִים בַּשָּׁנָה, הַמּוֹכֵר בְּהֵמָה…","l":"3–4","c":1},{"i":164,"s":22,"h":"״יוֹם אֶחָד״ הָאָמוּר בְּאוֹתוֹ וְאֶת…","l":"5"}]},{"n":6,"r":[{"i":165,"s":3,"h":"כִּסּוּי הַדָּם נוֹהֵג בָּאָרֶץ וּבְחוּצָה…","l":"1"},{"i":168,"s":9,"h":"הַשּׁוֹחֵט וְנִמְצֵאת טְרֵיפָה, וְהַשּׁוֹחֵט לַעֲבוֹדָה…","l":"2"},{"i":170,"s":8,"h":"חֵרֵשׁ שׁוֹטֶה וְקָטָן שֶׁשָּׁחֲטוּ, וַאֲחֵרִים…","l":"3"},{"i":171,"s":11,"h":"שָׁחַט מֵאָה חַיּוֹת בְּמָקוֹם אֶחָד…","l":"4"},{"i":172,"s":2,"h":"שָׁחַט וְלֹא כִּסָּה, וְרָאָהוּ אַחֵר…","l":"4","c":1},{"i":172,"s":21,"h":"דָּם שֶׁנִּתְעָרֵב בְּמַיִם אִם יֵשׁ…","l":"5–6"},{"i":174,"s":12,"h":"בַּמֶּה מְכַסִּין וּבַמֶּה אֵין מְכַסִּין?","l":"7"}]},{"n":7,"r":[{"i":177,"s":3,"h":"גִּיד הַנָּשֶׁה נוֹהֵג בָּאָרֶץ וּבְחוּצָה…","l":"1"},{"i":185,"s":33,"h":"שׁוֹלֵחַ אָדָם יָרֵךְ לְגוֹי שֶׁגִּיד…","l":"2"},{"i":190,"s":5,"h":"הַנּוֹטֵל גִּיד הַנָּשֶׁה, צָרִיךְ שֶׁיִּטּוֹל…","l":"2–3","c":1},{"i":191,"s":9,"h":"יָרֵךְ שֶׁנִּתְבַּשֵּׁל בָּהּ גִּיד הַנָּשֶׁה…","l":"4–5"},{"i":199,"s":3,"h":"נוֹהֵג בִּטְהוֹרָה, וְאֵינוֹ נוֹהֵג בִּטְמֵאָה.","l":"6"}]},{"n":8,"r":[{"i":205,"s":21,"h":"כׇּל הַבָּשָׂר אָסוּר לְבַשֵּׁל בְּחָלָב…","l":"1"},{"i":207,"s":8,"h":"הָעוֹף עוֹלֶה עִם הַגְּבִינָה עַל…","l":"1","c":1},{"i":213,"s":19,"h":"צוֹרֵר אָדָם בָּשָׂר וּגְבִינָה בְּמִטְפַּחַת…","l":"2"},{"i":214,"s":3,"h":"טִיפַּת חָלָב שֶׁנָּפְלָה עַל הַחֲתִיכָה…","l":"3"},{"i":216,"s":11,"h":"הַכְּחָל קוֹרְעוֹ וּמוֹצִיא אֶת חֶלְבּוֹ.","l":"3","c":1},{"i":224,"s":26,"h":"הַמַּעֲלֶה אֶת הָעוֹף עִם הַגְּבִינָה…","l":"3","c":1},{"i":224,"s":29,"h":"בְּשַׂר בְּהֵמָה טְהוֹרָה בַּחֲלֵב בְּהֵמָה…","l":"4"},{"i":230,"s":16,"h":"קֵבַת גּוֹי וְשֶׁל נְבֵלָה הֲרֵי…","l":"5"},{"i":231,"s":23,"h":"חוֹמֶר בַּחֵלֶב מִבַּדָּם, וְחוֹמֶר בַּדָּם מִבַּחֵלֶב.","l":"6"}]},{"n":9,"r":[{"i":233,"s":6,"h":"הָעוֹר, וְהָרוֹטֶב, וְהַקֵּיפֶה, וְהָאָלָל, וְהָעֲצָמוֹת…","l":"1"},{"i":242,"s":11,"h":"אֵלּוּ שֶׁעוֹרוֹתֵיהֶן כִּבְשָׂרָן: עוֹר הָאָדָם…","l":"2"},{"i":244,"s":6,"h":"הַמַּפְשִׁיט בַּבְּהֵמָה וּבַחַיָּה, בַּטְּהוֹרָה וּבַטְּמֵאָה…","l":"3"},{"i":246,"s":22,"h":"עוֹר שֶׁיֵּשׁ עָלָיו כְּזַיִת בָּשָׂר…","l":"4"},{"i":247,"s":30,"h":"קוּלִית הַמֵּת וְקוּלִית הַמּוּקְדָּשִׁין, הַנּוֹגֵעַ…","l":"5"},{"i":251,"s":14,"h":"בֵּיצַת הַשֶּׁרֶץ הַמְרוּקֶּמֶת טְהוֹרָה, נִיקְּבָה…","l":"6"},{"i":252,"s":24,"h":"הָאֵבֶר וְהַבָּשָׂר הַמְדוּלְדָּלִין בַּבְּהֵמָה, מְטַמְּאִין…","l":"7"},{"i":257,"s":9,"h":"הָאֵבֶר וְהַבָּשָׂר הַמְדוּלְדָּלִין בְּאָדָם טְהוֹרִים.","l":"8"}]},{"n":10,"r":[{"i":258,"s":1,"h":"הַזְּרוֹעַ וְהַלְּחָיַיִם וְהַקֵּבָה נוֹהֲגִין בָּאָרֶץ…","l":"1–2"},{"i":262,"s":24,"h":"בְּכוֹר שֶׁנִּתְעָרֵב בְּמֵאָה, בִּזְמַן שֶׁמֵּאָה…","l":"3"},{"i":266,"s":11,"h":"גֵּר שֶׁנִּתְגַּיֵּיר וְהָיְתָה לוֹ פָּרָה…","l":"4"},{"i":267,"s":16,"h":"אֵיזֶהוּ הַזְּרוֹעַ?","l":"4","c":1}]},{"n":11,"r":[{"i":268,"s":1,"h":"רֵאשִׁית הַגֵּז נוֹהֵג בָּאָרֶץ וּבְחוּצָה…","l":"1–2"}]},{"n":12,"r":[{"i":275,"s":4,"h":"שִׁילּוּחַ הַקֵּן נוֹהֵג בָּאָרֶץ וּבְחוּצָה…","l":"1–2"},{"i":279,"s":23,"h":"הָיְתָה מְעוֹפֶפֶת, בִּזְמַן שֶׁכְּנָפֶיהָ נוֹגְעוֹת…","l":"3"},{"i":280,"s":8,"h":"שִׁלְּחָהּ וְחָזְרָה, אֲפִילּוּ אַרְבָּעָה וַחֲמִשָּׁה…","l":"3","c":1},{"i":280,"s":19,"h":"הַנּוֹטֵל אֵם עַל הַבָּנִים רַבִּי…","l":"4"},{"i":282,"s":3,"h":"לֹא יִטּוֹל אָדָם אֵם עַל…","l":"5"}]}]}
