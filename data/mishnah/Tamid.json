{"m":"Tamid","v":1,"p":[{"n":1,"r":[{"i":49,"s":1,"h":"בִּשְׁלֹשָׁה מְקוֹמוֹת הַכֹּהֲנִים שׁוֹמְרִים בְּבֵית…","l":"1–2"},{"i":54,"s":16,"h":"נָטַל אֶת הַמַּפְתֵּחַ וּפָתַח אֶת…","l":"3–4"}]},{"n":2,"r":[{"i":55,"s":10,"h":"רָאוּהוּ אֶחָיו שֶׁיָּרַד, וְהֵם רָצִים וּבָאִים.","l":"1–5"}]},{"n":3,"r":[{"i":58,"s":7,"h":"אָמַר לָהֶן הַמְמוּנֶּה בּוֹאוּ וְהָפִיסוּ…","l":"1–9"}]},{"n":4,"r":[{"i":59,"s":20,"h":"לֹא הָיוּ כּוֹפְתִין אֶת הַטָּלֶה…","l":"1–3"}]},{"n":5,"r":[{"i":63,"s":15,"h":"א אָמַר לָהֶם הַמְמוּנֶּה: בָּרְכוּ…","l":"1–6"}]},{"n":6,"r":[{"i":64,"s":9,"h":"א הֵחֵלּוּ עוֹלִים בְּמַעֲלוֹת הָאוּלָם.","l":"1–3"}]},{"n":7,"r":[{"i":65,"s":1,"h":"בִּזְמַן שֶׁכֹּהֵן גָּדוֹל נִכְנָס לְהִשְׁתַּחֲוֹת…","l":"1–4"}]}]}
