{"m":"Meilah","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"קׇדְשֵׁי קָדָשִׁים שֶׁשְּׁחָטָן בַּדָּרוֹם מוֹעֲלִין בָּהֶן.","l":"1"},{"i":11,"s":1,"h":"בְּשַׂר קׇדְשֵׁי קָדָשִׁים שֶׁיָּצָא לִפְנֵי…","l":"2–3"},{"i":13,"s":8,"h":"יֵשׁ מַעֲשֵׂה דָמִים בְּקׇדְשֵׁי קָדָשִׁים…","l":"4"}]},{"n":2,"r":[{"i":14,"s":3,"h":"חַטַּאת הָעוֹף מוֹעֲלִין בָּהּ מִשֶּׁהוּקְדְּשָׁה…","l":"1"},{"i":16,"s":8,"h":"עוֹלַת הָעוֹף מוֹעֲלִין בָּהּ מִשֶּׁהוּקְדְּשָׁה.","l":"2–8"},{"i":18,"s":8,"h":"הַקּוֹמֶץ, וְהַלְּבוֹנָה, וְהַקְּטוֹרֶת, וּמִנְחַת כֹּהֲנִים…","l":"9"}]},{"n":3,"r":[{"i":19,"s":11,"h":"וְלַד חַטָּאת, וּתְמוּרַת חַטָּאת, וְחַטָּאת…","l":"1"},{"i":20,"s":6,"h":"הַמַּפְרִישׁ מָעוֹת לִנְזִירוּתוֹ לֹא נֶהֱנִין…","l":"2"},{"i":20,"s":12,"h":"רַבִּי שִׁמְעוֹן אוֹמֵר: הַדָּם קַל…","l":"3"},{"i":21,"s":18,"h":"דִּישּׁוּן מִזְבֵּחַ הַפְּנִימִי, וְהַמְּנוֹרָה לֹא…","l":"4"},{"i":22,"s":7,"h":"רַבִּי שִׁמְעוֹן אוֹמֵר תּוֹרִין שֶׁלֹּא…","l":"4","c":1},{"i":23,"s":9,"h":"חֲלֵב הַמּוּקְדָּשִׁין וּבֵיצֵי תוֹרִין לֹא…","l":"5"},{"i":23,"s":13,"h":"כׇּל הָרָאוּי לַמִּזְבֵּחַ וְלֹא לְבֶדֶק…","l":"6"},{"i":25,"s":1,"h":"שׇׁרְשֵׁי אִילָן שֶׁל הֶדְיוֹט הַבָּאִין…","l":"7"},{"i":25,"s":14,"h":"הַקֵּן שֶׁבְּרֹאשׁ הָאִילָן שֶׁל הֶקְדֵּשׁ…","l":"8"},{"i":26,"s":12,"h":"הַגִּזְבָּרִים שֶׁלָּקְחוּ עֵצִים מוֹעֲלִין בָּעֵצִים…","l":"8","c":1}]},{"n":4,"r":[{"i":28,"s":1,"h":"קׇדְשֵׁי מִזְבֵּחַ, מִצְטָרְפִין זֶה עִם…","l":"1"},{"i":29,"s":1,"h":"חֲמִשָּׁה דְּבָרִים בָּעוֹלָה מִצְטָרְפִין זֶה…","l":"2"},{"i":29,"s":16,"h":"הַתְּרוּמָה, וּתְרוּמַת מַעֲשֵׂר, וּתְרוּמַת מַעֲשֵׂר…","l":"2–3","c":1},{"i":29,"s":20,"h":"כׇּל הַנְּבֵילוֹת מִצְטָרְפִין זוֹ עִם זוֹ.","l":"3","c":1},{"i":32,"s":2,"h":"דַּם הַשֶּׁרֶץ וְהַבָּשָׂר מִצְטָרְפִין זֶה…","l":"3","c":1},{"i":33,"s":11,"h":"הַפִּיגּוּל וְהַנּוֹתָר אֵין מִצְטָרְפִין, מִפְּנֵי…","l":"4"},{"i":33,"s":15,"h":"הָאוֹכֶל שֶׁנִּטְמָא בְּאַב הַטּוּמְאָה, וְשֶׁנִּטְמָא…","l":"4–5","c":1},{"i":34,"s":1,"h":"הָעׇרְלָה וְכִלְאֵי הַכֶּרֶם מִצְטָרְפִין זֶה…","l":"6"},{"i":34,"s":4,"h":"הַבֶּגֶד וְהַשַּׂק, הַשַּׂק וְהָעוֹר, הָעוֹר…","l":"6","c":1}]},{"n":5,"r":[{"i":34,"s":11,"h":"הַנֶּהֱנֶה מִן הַהֶקְדֵּשׁ שָׁוֶה פְּרוּטָה…","l":"1"},{"i":37,"s":1,"h":"נֶהֱנָה כְּבַחֲצִי פְרוּטָה וּפָגַם כַּחֲצִי…","l":"2–3"},{"i":37,"s":16,"h":"נָטַל אֶבֶן אוֹ קוֹרָה שֶׁל…","l":"4–5"}]},{"n":6,"r":[{"i":38,"s":15,"h":"הַשָּׁלִיחַ שֶׁעָשָׂה שְׁלִיחוּתוֹ בַּעַל הַבַּיִת מָעַל.","l":"1"},{"i":40,"s":2,"h":"אָמַר לוֹ: ״הָבֵא לִי מִן…","l":"1–2","c":1},{"i":40,"s":16,"h":"נָתַן לוֹ פְּרוּטָה, אָמַר לוֹ…","l":"3–4"},{"i":41,"s":10,"h":"הַמַּפְקִיד מָעוֹת אֵצֶל שׁוּלְחָנִי, אִם…","l":"5–6"}]}]}
