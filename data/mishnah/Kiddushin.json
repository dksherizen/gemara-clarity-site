{"m":"Kiddushin","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"הָאִשָּׁה נִקְנֵית בְּשָׁלֹשׁ דְּרָכִים, וְקוֹנָה…","l":"1"},{"i":27,"s":3,"h":"עֶבֶד עִבְרִי נִקְנֶה בְּכֶסֶף וּבִשְׁטָר…","l":"2"},{"i":43,"s":10,"h":"עֶבֶד כְּנַעֲנִי נִקְנֶה בְּכֶסֶף וּבִשְׁטָר…","l":"3"},{"i":49,"s":5,"h":"בְּהֵמָה גַּסָּה נִקְנֵית בִּמְסִירָה, וְהַדַּקָּה…","l":"4"},{"i":50,"s":2,"h":"נְכָסִים שֶׁיֵּשׁ לָהֶם אַחְרָיוּת נִקְנִין…","l":"5"},{"i":54,"s":12,"h":"כׇּל הַנַּעֲשֶׂה דָּמִים בְּאַחֵר, כֵּיוָן…","l":"6"},{"i":55,"s":12,"h":"רְשׁוּת הַגָּבוֹהַּ בְּכֶסֶף, וּרְשׁוּת הַהֶדְיוֹט בַּחֲזָקָה.","l":"6","c":1},{"i":56,"s":8,"h":"כׇּל מִצְוֹת הַבֵּן עַל הָאָב…","l":"7"},{"i":70,"s":24,"h":"הַסְּמִיכוֹת, וְהַתְּנוּפוֹת, וְהַהַגָּשׁוֹת, וְהַקְּמִיצוֹת, וְהַהַקְטָרוֹת…","l":"8"},{"i":71,"s":15,"h":"כׇּל מִצְוָה שֶׁהִיא תְּלוּיָה בָּאָרֶץ…","l":"9"},{"i":77,"s":2,"h":"כׇּל הָעוֹשֶׂה מִצְוָה אַחַת מְטִיבִין…","l":"10"},{"i":79,"s":6,"h":"כֹּל שֶׁיֶּשְׁנוֹ בַּמִּקְרָא וּבַמִּשְׁנָה וּבְדֶרֶךְ…","l":"10","c":1}]},{"n":2,"r":[{"i":80,"s":4,"h":"הָאִישׁ מְקַדֵּשׁ בּוֹ וּבִשְׁלוּחוֹ.","l":"1"},{"i":90,"s":10,"h":"הָאוֹמֵר לְאִשָּׁה ״הִתְקַדְּשִׁי לִי בִּתְמָרָה…","l":"1","c":1},{"i":95,"s":8,"h":"״הִתְקַדְּשִׁי לִי בְּכוֹס זֶה שֶׁל…","l":"2"},{"i":97,"s":18,"h":"״עַל מְנָת שֶׁאֲנִי כֹּהֵן״ וְנִמְצָא…","l":"3"},{"i":98,"s":22,"h":"הָאוֹמֵר לִשְׁלוּחוֹ: ״צֵא וְקַדֵּשׁ לִי…","l":"4"},{"i":98,"s":26,"h":"הַמְקַדֵּשׁ אֶת הָאִשָּׁה עַל מְנָת…","l":"5"},{"i":98,"s":30,"h":"הַמְקַדֵּשׁ שְׁתֵּי נָשִׁים בְּשָׁוֶה פְּרוּטָה…","l":"6"},{"i":99,"s":19,"h":"הַמְקַדֵּשׁ אִשָּׁה וּבִתָּהּ אוֹ אִשָּׁה…","l":"7"},{"i":103,"s":13,"h":"הַמְקַדֵּשׁ בְּחֶלְקוֹ, בֵּין קׇדְשֵׁי קֳדָשִׁים…","l":"8"},{"i":111,"s":7,"h":"הַמְקַדֵּשׁ בְּעׇרְלָה, בְּכִלְאֵי הַכֶּרֶם, בְּשׁוֹר…","l":"9"},{"i":114,"s":22,"h":"הַמְקַדֵּשׁ בִּתְרוּמוֹת וּבַמַּעַשְׂרוֹת, וּבַמַּתָּנוֹת, וּבְמֵי…","l":"10"}]},{"n":3,"r":[{"i":115,"s":15,"h":"הָאוֹמֵר לַחֲבֵירוֹ: ״צֵא וְקַדֵּשׁ לִי…","l":"1"},{"i":118,"s":17,"h":"הָאוֹמֵר לְאִשָּׁה ״הֲרֵי אַתְּ מְקוּדֶּשֶׁת…","l":"2"},{"i":119,"s":24,"h":"״עַל מְנָת שֶׁיֵּשׁ לִי בֵּית…","l":"3"},{"i":120,"s":14,"h":"רַבִּי מֵאִיר אוֹמֵר: כׇּל תְּנַאי…","l":"4"},{"i":122,"s":14,"h":"הַמְקַדֵּשׁ אֶת הָאִשָּׁה וְאָמַר: כְּסָבוּר…","l":"5"},{"i":124,"s":11,"h":"הָאוֹמֵר לָאִשָּׁה ״הֲרֵי אַתְּ מְקוּדֶּשֶׁת…","l":"6"},{"i":124,"s":19,"h":"״עַל מְנָת שֶׁיִּרְצֶה אַבָּא״, רָצָה…","l":"6","c":1},{"i":125,"s":8,"h":"״קִדַּשְׁתִּי אֶת בִּתִּי וְאֵינִי יוֹדֵעַ…","l":"7"},{"i":126,"s":2,"h":"״קִדַּשְׁתִּי אֶת בִּתִּי״, ״קִדַּשְׁתִּיהָ וְגֵרַשְׁתִּיהָ…","l":"8"},{"i":126,"s":16,"h":"מִי שֶׁאָמַר בִּשְׁעַת מִיתָתוֹ ״יֵשׁ…","l":"8","c":1},{"i":127,"s":3,"h":"הַמְקַדֵּשׁ אֶת בִּתּוֹ סְתָם אֵין…","l":"8–9","c":1},{"i":128,"s":9,"h":"הָאוֹמֵר לְאִשָּׁה: ״קִדַּשְׁתִּיךְ״ וְהִיא אוֹמֶרֶת…","l":"10–11"},{"i":131,"s":23,"h":"כׇּל מָקוֹם שֶׁיֵּשׁ קִידּוּשִׁין וְאֵין…","l":"12"},{"i":136,"s":4,"h":"רַבִּי טַרְפוֹן אוֹמֵר: יְכוֹלִין מַמְזֵרִין לִיטָּהֵר.","l":"13"}]},{"n":4,"r":[{"i":136,"s":20,"h":"עֲשָׂרָה יוּחֲסִים עָלוּ מִבָּבֶל: כָּהֲנֵי…","l":"1–2"},{"i":146,"s":18,"h":"כׇּל הָאֲסוּרִין לָבֹא בַּקָּהָל מוּתָּרִים…","l":"3"},{"i":150,"s":17,"h":"הַנּוֹשֵׂא אִשָּׁה כֹּהֶנֶת צָרִיךְ לִבְדּוֹק…","l":"4–5"},{"i":152,"s":1,"h":"בַּת חָלָל זָכָר פְּסוּלָה מִן…","l":"6–7"},{"i":155,"s":13,"h":"הָאוֹמֵר ״בְּנִי זֶה מַמְזֵר״ אֵינוֹ נֶאֱמָן.","l":"8"},{"i":155,"s":25,"h":"מִי שֶׁנָּתַן רְשׁוּת לִשְׁלוּחוֹ לְקַדֵּשׁ…","l":"9"},{"i":157,"s":13,"h":"מִי שֶׁיָּצָא הוּא וְאִשְׁתּוֹ לִמְדִינַת…","l":"10–11"},{"i":159,"s":5,"h":"לֹא יִתְיַיחֵד אָדָם עִם שְׁתֵּי…","l":"12"},{"i":162,"s":2,"h":"לֹא יְלַמֵּד אָדָם רַוּוֹק סוֹפְרִים.","l":"13–14"},{"i":162,"s":9,"h":"כֹּל שֶׁעֲסָקָיו עִם הַנָּשִׁים לֹא…","l":"14","c":1}]}]}
