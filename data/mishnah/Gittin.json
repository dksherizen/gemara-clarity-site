{"m":"Gittin","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"הַמֵּבִיא גֵּט מִמְּדִינַת הַיָּם, צָרִיךְ…","l":"1–3"},{"i":16,"s":10,"h":"הַמֵּבִיא גֵּט מִמְּדִינַת הַיָּם, וְאֵינוֹ…","l":"3–4","c":1},{"i":18,"s":6,"h":"כׇּל גֵּט שֶׁיֵּשׁ עָלָיו עֵד…","l":"5"},{"i":19,"s":14,"h":"כׇּל הַשְּׁטָרוֹת הָעוֹלִים בְּעַרְכָּאוֹת שֶׁל…","l":"5","c":1},{"i":21,"s":7,"h":"הָאוֹמֵר ״תֵּן גֵּט זֶה לְאִשְׁתִּי…","l":"6"},{"i":24,"s":8,"h":"הָאוֹמֵר ״תְּנוּ גֵּט זֶה לְאִשְׁתִּי…","l":"6","c":1}]},{"n":2,"r":[{"i":28,"s":16,"h":"הַמֵּבִיא גֵּט מִמְּדִינַת הַיָּם, וְאָמַר…","l":"1"},{"i":32,"s":15,"h":"נִכְתַּב בַּיּוֹם וְנֶחְתַּם בַּיּוֹם; בַּלַּיְלָה…","l":"2"},{"i":36,"s":6,"h":"בַּכֹּל כּוֹתְבִים בִּדְיוֹ, בְּסַם, בְּסִיקְרָא…","l":"3"},{"i":41,"s":12,"h":"אֵין כּוֹתְבִין בִּמְחוּבָּר לַקַּרְקַע.","l":"4"},{"i":43,"s":8,"h":"הַכֹּל כְּשֵׁרִין לִכְתּוֹב אֶת הַגֵּט…","l":"5"},{"i":44,"s":21,"h":"הַכֹּל כְּשֵׁרִין לְהָבִיא אֶת הַגֵּט…","l":"5–6","c":1},{"i":45,"s":14,"h":"אַף הַנָּשִׁים שֶׁאֵינָן נֶאֱמָנוֹת לוֹמַר…","l":"7"}]},{"n":3,"r":[{"i":46,"s":20,"h":"כׇּל גֵּט שֶׁנִּכְתַּב שֶׁלֹּא לְשׁוּם…","l":"1"},{"i":50,"s":4,"h":"הַכּוֹתֵב טוֹפְסֵי גִּיטִּין, צָרִיךְ שֶׁיַּנִּיחַ…","l":"2"},{"i":52,"s":1,"h":"הַמֵּבִיא גֵּט וְאָבַד הֵימֶנּוּ; מְצָאוֹ…","l":"3"},{"i":54,"s":10,"h":"הַמֵּבִיא גֵּט, וְהִנִּיחוֹ זָקֵן אוֹ…","l":"3","c":1},{"i":55,"s":11,"h":"שְׁלֹשָׁה דְּבָרִים אָמַר רַבִּי אֶלְעָזָר…","l":"4"},{"i":56,"s":10,"h":"הַמֵּבִיא גֵּט בְּאֶרֶץ יִשְׂרָאֵל, וְחָלָה…","l":"5"},{"i":57,"s":3,"h":"הַמֵּבִיא גֵּט מִמְּדִינַת הַיָּם, וְחָלָה…","l":"6"},{"i":58,"s":10,"h":"הַמַּלְוֶה מָעוֹת אֶת הַכֹּהֵן וְאֶת…","l":"7"},{"i":60,"s":3,"h":"הַמַּנִּיחַ פֵּירוֹת, לִהְיוֹת מַפְרִישׁ עֲלֵיהֶן…","l":"8"}]},{"n":4,"r":[{"i":62,"s":5,"h":"הַשּׁוֹלֵחַ גֵּט לְאִשְׁתּוֹ, וְהִגִּיעַ בַּשָּׁלִיחַ…","l":"1–2"},{"i":67,"s":2,"h":"בָּרִאשׁוֹנָה הָיָה מְשַׁנֶּה שְׁמוֹ וּשְׁמָהּ…","l":"2","c":1},{"i":67,"s":12,"h":"אֵין אַלְמָנָה נִפְרַעַת מִנִּכְסֵי יְתוֹמִים…","l":"3"},{"i":73,"s":16,"h":"עֶבֶד שֶׁנִּשְׁבָּה