{"m":"Bava_Kamma","v":1,"p":[{"n":1,"r":[{"i":2,"s":1,"h":"אַרְבָּעָה אֲבוֹת נְזִיקִין: הַשּׁוֹר, וְהַבּוֹר…","l":"1"},{"i":17,"s":5,"h":"כֹּל שֶׁחַבְתִּי בִּשְׁמִירָתוֹ הִכְשַׁרְתִּי אֶת נִזְקוֹ.","l":"2"},{"i":27,"s":2,"h":"שׁוּם כֶּסֶף, שָׁוֶה כֶּסֶף.","l":"3"},{"i":29,"s":22,"h":"חֲמִשָּׁה תַּמִּין וַחֲמִשָּׁה מוּעָדִין הַבְּהֵמָה…","l":"4"},{"i":31,"s":21,"h":"מָה בֵּין תָּם לְמוּעָד?","l":"4","c":1}]},{"n":2,"r":[{"i":32,"s":17,"h":"כֵּיצַד הָרֶגֶל מוּעֶדֶת?","l":"1"},{"i":37,"s":21,"h":"כֵּיצַד הַשֵּׁן מוּעֶדֶת?","l":"2"},{"i":41,"s":9,"h":"הַכֶּלֶב וְהַגְּדִי שֶׁקָּפְצוּ מֵרֹאשׁ הַגָּג…","l":"3"},{"i":45,"s":22,"h":"אֵיזֶהוּ תָּם וְאֵיזֶהוּ מוּעָד?","l":"4"},{"i":47,"s":16,"h":"שׁוֹר הַמַּזִּיק בִּרְשׁוּת הַנִּיזָּק, כֵּיצַד?","l":"5"},{"i":50,"s":27,"h":"אָדָם מוּעָד לְעוֹלָם בֵּין שׁוֹגֵג…","l":"6"}]},{"n":3,"r":[{"i":52,"s":15,"h":"הַמַּנִּיחַ אֶת הַכַּד בִּרְשׁוּת הָרַבִּים…","l":"1"},{"i":54,"s":32,"h":"נִשְׁבְּרָה כַּדּוֹ בִּרְשׁוּת הָרַבִּים, וְהוּחְלַק…","l":"1","c":1},{"i":58,"s":3,"h":"הַשּׁוֹפֵךְ מַיִם בִּרְשׁוּת הָרַבִּים, וְהוּזַּק…","l":"2"},{"i":58,"s":23,"h":"הַמּוֹצִיא אֶת תִּבְנוֹ וְקַשּׁוֹ לִרְשׁוּת…","l":"3"},{"i":60,"s":4,"h":"שְׁנֵי קַדָּרִין שֶׁהָיוּ מְהַלְּכִין זֶה…","l":"4"},{"i":61,"s":13,"h":"זֶה בָּא בְּחָבִיתוֹ וְזֶה בָּא…","l":"5"},{"i":62,"s":18,"h":"שְׁנַיִם שֶׁהָיוּ מְהַלְּכִין בִּרְשׁוּת הָרַבִּים…","l":"6"},{"i":63,"s":3,"h":"הַמְבַקֵּעַ בִּרְשׁוּת הָרַבִּים וְהִזִּיק בִּרְשׁוּת…","l":"7"},{"i":64,"s":10,"h":"שְׁנֵי שְׁווֹרִין תַּמִּין שֶׁחָבְלוּ זֶה…","l":"8"},{"i":64,"s":23,"h":"שׁוֹר שָׁוֶה מָנֶה שֶׁנָּגַח שׁוֹר…","l":"9"},{"i":66,"s":14,"h":"שׁוֹר שָׁוֶה מָאתַיִם שֶׁנָּגַח שׁוֹר…","l":"9","c":1},{"i":67,"s":16,"h":"יֵשׁ חַיָּיב עַל מַעֲשֵׂה שׁוֹרוֹ…","l":"10"},{"i":68,"s":15,"h":"שׁוֹר שֶׁהָיָה רוֹדֵף אַחַר שׁוֹר…","l":"11"}]},{"n":4,"r":[{"i":70,"s":12,"h":"שׁוֹר שֶׁנָּגַח אַרְבָּעָה וַחֲמִשָּׁה שְׁוָורִים…","l":"1"},{"i":72,"s":5,"h":"שׁוֹר שֶׁהוּא מוּעָד לְמִינוֹ, וְאֵינוֹ…","l":"2"},{"i":73,"s":11,"h":"שׁוֹר שֶׁל יִ